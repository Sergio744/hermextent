{
  "manifest_version": 3,
  "name": "Hermes Browser",
  "version": "0.1.0",
  "description": "Hermes Agent dans Chrome, avec relais sécurisé vers un compagnon local.",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "storage", "tabs", "scripting", "cookies", "sidePanel"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "https://chat.deepseek.com/*",
    "https://*.deepseek.com/*",
    "https://www.doubao.com/*",
    "https://*.doubao.com/*",
    "https://gemini.google.com/*",
    "https://*.google.com/*",
    "https://chat.z.ai/*",
    "https://*.z.ai/*",
    "https://chatglm.cn/*",
    "https://*.chatglm.cn/*",
    "https://www.kimi.com/*",
    "https://*.kimi.com/*",
    "https://qianwen.com/*",
    "https://*.qianwen.com/*",
    "https://chat.qwen.ai/*",
    "https://*.qwen.ai/*",
    "https://ai.rakuten.co.jp/*",
    "https://*.rakuten.co.jp/*"
  ],
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "action": { "default_title": "Ouvrir Hermes Browser" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
